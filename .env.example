# Copy to .env and fill in your values.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Alternative models:
# GEMINI_MODEL=gemini-2.5-flash-lite
# GEMINI_MODEL=gemini-2.0-flash

# Optional: limit examples for a quick smoke test (omit or set to 0 for full run)
# MAX_EXAMPLES=5

# Parallel workers (1 = serial). Free tier has rate limits — start with 2–3.
MAX_WORKERS=3

# Retries when the API fails
API_MAX_RETRIES=3
