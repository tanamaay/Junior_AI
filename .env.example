# Copy to .env and fill in your values.
# Get a key at https://console.groq.com/
GROQ_API_KEY=gsk_your-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Faster/cheaper alternative:
# GROQ_MODEL=llama-3.1-8b-instant

# Optional: limit examples for a quick smoke test (omit or set to 0 for full run)
# MAX_EXAMPLES=5

# Parallel workers (1 = serial). Groq has rate limits — start with 3–5.
MAX_WORKERS=3

# Retries when the API fails
API_MAX_RETRIES=3
