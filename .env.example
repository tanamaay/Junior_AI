# Copy to .env and fill in your values.
# Get a key at https://console.groq.com/
GROQ_API_KEY=gsk_your-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Faster alternative:
# GROQ_MODEL=llama-3.1-8b-instant

# Optional: limit examples for a quick smoke test
# MAX_EXAMPLES=5

# Parallel workers (Groq allows more than Gemini free tier)
MAX_WORKERS=3

# Optional delay between requests in seconds (0 = no delay)
API_REQUEST_INTERVAL_SEC=0

API_MAX_RETRIES=5
